# Copy to .env and replace every "change-me" value before running `docker compose up`.
# .env is git-ignored and excluded from Docker build contexts. Never commit real credentials.

# --- PostgreSQL (data tier) -------------------------------------------------
# Owner / migration role. Owns the schema and runs migrations. Not used by the API at runtime.
POSTGRES_DB=taskdb
POSTGRES_USER=task_owner
POSTGRES_PASSWORD=change-me-owner-password

# Least-privilege runtime role used by the API (SELECT/INSERT/UPDATE/DELETE only).
# Read on first database initialisation only; changing it later needs a fresh volume.
APP_DB_USER=task_app
APP_DB_PASSWORD=change-me-app-password

# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5432

# --- Application / presentation tiers --------------------------------------
# Host port for the web UI: http://localhost:8080
WEB_HOST_PORT=8080
LOG_LEVEL=info

# Images to run. Defaults are the locally built tags; point these at ECR to run a
# published build, e.g. <account>.dkr.ecr.<region>.amazonaws.com/task-platform/backend:<git-sha>
# (and .../task-platform/frontend:<git-sha> for WEB_IMAGE). See README "Docker Compose deployment".
# API_IMAGE=task-api:local
# WEB_IMAGE=task-web:local
