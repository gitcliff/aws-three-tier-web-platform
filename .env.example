# Copy to .env and replace every "change-me" value before running `docker compose up`.
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL (data tier) -------------------------------------------------
# Owner / migration role. Owns the schema and runs migrations. Not used by the API at runtime.
POSTGRES_DB=taskdb
POSTGRES_USER=task_owner
POSTGRES_PASSWORD=change-me-owner-password

# Least-privilege runtime role used by the API (SELECT/INSERT/UPDATE/DELETE only).
APP_DB_USER=task_app
APP_DB_PASSWORD=change-me-app-password

# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5432
