# Local development settings for the API (`npm run dev`). Copy to backend/.env.
# backend/.env is git-ignored. In containers these come from Compose / the orchestrator.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Connection used by the API at runtime: the least-privilege app role.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskdb
DB_USER=task_app
DB_PASSWORD=change-me-app-password
# Set to true when the database requires TLS (e.g. Amazon RDS).
DB_SSL=false
DB_POOL_MAX=10

# Migrations need the owner role. Override DB_USER/DB_PASSWORD when running them, e.g.
#   DB_USER=task_owner DB_PASSWORD=... npm run migrate:dev
MIGRATIONS_DIR=../database/migrations

# Integration tests only (`npm run test:integration`): a database the tests may freely wipe.
# Uses the owner role, because the tests run migrations and truncate tables.
TEST_DATABASE_URL=postgres://task_owner:change-me-owner-password@localhost:5432/taskdb_test
