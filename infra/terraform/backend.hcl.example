# For running this stack locally: copy to backend.hcl (git-ignored), then
#   terraform init -backend-config=backend.hcl
# The pipeline passes the same values from GitHub variables. Use the bucket created by
# infra/bootstrap; its default encryption (customer-managed KMS key) applies to state, so
# `encrypt` is deliberately not set here (it would override that with SSE-S3).
bucket       = "task-platform-tfstate-123456789012-us-east-1"
key          = "task-platform/ecr/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
