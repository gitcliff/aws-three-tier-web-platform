# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
# The bucket must exist first; see infra/terraform/README.md for a one-time bootstrap.
bucket       = "your-terraform-state-bucket"
key          = "task-platform/ecr-oidc/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
