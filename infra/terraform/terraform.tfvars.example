# For running this stack locally: copy to terraform.tfvars (git-ignored).
# The pipeline sets these through TF_VAR_* environment variables instead.
aws_region               = "us-east-1"
project_name             = "task-platform"
github_repository        = "your-github-user/aws-three-tier-web-platform"
github_branch            = "main"
permissions_boundary_arn = "arn:aws:iam::123456789012:policy/task-platform-app-role-boundary"
